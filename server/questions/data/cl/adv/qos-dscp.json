    {
      "id": "qs-6bit",
      "ja": "DSCP は IP ヘッダの 6 ビットで、0〜63 の値をとる",
      "attrs": {
        "true": true,
        "why": "元の ToS の 8 ビットのうち上の 6 ビットが DSCP、残りの 2 ビットは ECN。"
      },
      "source": "RFC 2474・RFC 3168",
      "checkedBy": "Claude Opus 5.5 2026-10-22"
    },
    {
      "id": "qs-ef-low-delay",
      "ja": "EF は、遅れと揺らぎを小さくしたい通信(音声など)のための印である",
      "attrs": {
        "true": true,
        "why": "EF は待たせずに送る扱いのための印で、音声によく使う。"
      },
      "source": "RFC 3246",
      "checkedBy": "Claude Opus 5.5 2026-10-22"
    },
    {
      "id": "qs-af-drop",
      "ja": "AF の印では、AFxy の y が大きいほど、混んだときに先に捨てられやすい",
      "attrs": {
        "true": true,
        "why": "y は捨てやすさ(1 が捨てにくく 3 が捨てやすい)。x は列(クラス)。"
      },
      "source": "RFC 2597",
      "checkedBy": "Claude Opus 5.5 2026-10-22"
    },
    {
      "id": "qs-cs-compat",
      "ja": "CS の印の値は 8 の倍数で、昔の IP 優先度(3 ビット)と同じ順に並ぶ",
      "attrs": {
        "true": true,
        "why": "CSn の値は n × 8。上の 3 ビットが昔の IP 優先度にあたる。"
      },
      "source": "RFC 2474 4.2.2",
      "checkedBy": "Claude Opus 5.5 2026-10-22"
    },
    {
      "id": "qs-vlan",
      "ja": "DSCP は、VLAN タグの中の 3 ビットである",
      "attrs": {
        "true": false,
        "why": "VLAN タグの 3 ビットは PCP(CoS)。DSCP は IP ヘッダの 6 ビット。"
      },
      "source": "RFC 2474・IEEE 802.1Q",
      "checkedBy": "Claude Opus 5.5 2026-10-22"
    },
    {
      "id": "qs-bigger-first",
      "ja": "DSCP の値が大きいほど、途中のどの機器でも必ず先に送られる",
      "attrs": {
        "true": false,
        "why": "印をどう扱うかは各機器の設定(方針)で決まる。値の大きさだけで決まるわけではない。"
      },
      "source": "RFC 2474",
      "checkedBy": "Claude Opus 5.5 2026-10-22"
    },
    {
      "id": "qs-af-y-safe",
      "ja": "AF の印では、AFxy の y が大きいほど、混んだときに捨てられにくい",
      "attrs": {
        "true": false,
        "why": "逆。y が大きいほど先に捨てられやすい。"
      },
      "source": "RFC 2597",
      "checkedBy": "Claude Opus 5.5 2026-10-22"
    },
    {
      "id": "qs-8bit",
      "ja": "DSCP は 8 ビットで、0〜255 の値をとる",
      "attrs": {
        "true": false,
        "why": "DSCP は 6 ビットで 0〜63。"
      },
      "source": "RFC 2474",
      "checkedBy": "Claude Opus 5.5 2026-10-22"
    }
  ]
